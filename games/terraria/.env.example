# Published image. Use a sha-<full-commit-hash> tag to pin a specific build.
IMAGE=ghcr.io/gene9831/terraria:latest

# Published host endpoint. Set an explicit LAN address to allow remote clients.
HOST=127.0.0.1
PORT=7777

# Runtime identity. The host data directory must be writable by this identity.
PUID=1000
PGID=1000

# Leave empty to use or create data/worlds/default.wld.
# For an existing world, set its filename only, for example WORLD_FILE='My World.wld'.
WORLD_FILE=

# Applied only when creating default.wld.
# World size options: small, medium, large.
WORLD_SIZE=medium
# World difficulty options: classic, expert, master, journey.
WORLD_DIFFICULTY=classic

# Scheduled world save and backup. Both values must be positive integers.
# Unchanged worlds are skipped while no players are connected.
SAVE_INTERVAL_MINUTES=10
# Retained scheduled snapshots per world. Upgrade backups are kept separately.
BACKUP_KEEP=5
